# ========================
# LaundryKu v1.0 - Environment Variables
# ========================

# Backend
NODE_ENV=development
PORT=4001

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://laundryku:laundryku_secret_2026@localhost:5433/laundryku

# MongoDB (WhatsApp data)
MONGODB_URI=mongodb://localhost:27018/laundryku_wa

# Redis
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# SuperAdmin Default Credentials (seed)
SUPERADMIN_EMAIL=superadmin@laundryku.com
SUPERADMIN_PASSWORD=SuperAdmin@2026
SUPERADMIN_NAME=Super Admin

# WhatsApp (Baileys)
WA_SESSION_DIR=./wa-sessions

# Email (for password reset - configure with your SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@laundryku.com
